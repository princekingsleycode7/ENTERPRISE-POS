{
  "name": "modern-pos-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/shared-services",
    "web",
    "mobile"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "dev:mobile": "npm run dev --workspace=mobile",
    "dev": "npm run dev:web",
    "build:web": "npm run build --workspace=web",
    "build:mobile": "npm run build --workspace=mobile",
    "build:services": "npm run build --workspace=packages/shared-services",
    "build": "npm run build:services && npm run build:web",
    "install:all": "npm install",
    "type-check": "npm run type-check --workspaces"
  },
  "dependencies": {
    "react-dom": "^19.2.4",
    "react": "^19.2.4",
    "firebase": "^12.9.0",
    "react-router-dom": "^7.13.0",
    "lucide-react": "^0.574.0",
    "dexie-react-hooks": "^4.2.0",
    "zustand": "^5.0.11",
    "dexie": "^4.3.0",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
