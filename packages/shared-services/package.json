{
  "name": "@pos/shared-services",
  "version": "1.0.0",
  "description": "Shared services and types for POS web and mobile apps",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./stores": {
      "import": "./dist/stores/index.js",
      "types": "./dist/stores/index.d.ts"
    },
    "./db": {
      "import": "./dist/db/index.js",
      "types": "./dist/db/index.d.ts"
    },
    "./config": {
      "import": "./dist/config/env.js",
      "types": "./dist/config/env.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "zustand": "^5.0.11",
    "dexie": "^4.3.0"
  },
  "devDependencies": {
    "typescript": "~5.8.2",
    "@types/node": "^22.14.0"
  }
}
