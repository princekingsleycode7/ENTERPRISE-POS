{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "types": ["node", "react-native"],
    "skipLibCheck": true
  },
  "include": ["src", "app.json"],
  "exclude": ["node_modules", "build", ".expo"]
}
