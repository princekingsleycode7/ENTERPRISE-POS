// firestore.rules
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    function hasRequiredFields(data, required) {
      return required.toSet().difference(data.keys().toSet()).size() == 0;
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function isValidRole(role) {
      return role in ['cashier', 'manager', 'admin'];
    }

    // FIX: Added 'bank_transfer' and 'moniepoint' to match app types
    function isValidPaymentMethod(method) {
      return method in ['cash', 'card', 'bank_transfer', 'moniepoint', 'transfer', 'split'];
    }

    // FIX: Added 'paid' to match app types
    function isValidPaymentStatus(status) {
      return status in ['completed', 'paid', 'pending', 'void', 'failed'];
    }

    function onlyUpdates(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // =========================================================================
    // PRODUCTS COLLECTION
    // =========================================================================

    match /products/{productId} {
      allow read: if true;

      allow create: if
        hasRequiredFields(request.resource.data, ['name', 'price', 'sku', 'category']) &&
        isNonEmptyString(request.resource.data.name) &&
        isNonEmptyString(request.resource.data.sku) &&
        isNonEmptyString(request.resource.data.category) &&
        request.resource.data.price is number &&
        request.resource.data.price >= 0;

      allow update: if
        (!('name' in request.resource.data) || isNonEmptyString(request.resource.data.name)) &&
        (!('price' in request.resource.data) || (request.resource.data.price is number && request.resource.data.price >= 0));

      // FIX: App supports deleting products
      allow delete: if true;
    }

    // =========================================================================
    // EMPLOYEES COLLECTION
    // =========================================================================

    match /employees/{employeeId} {
      allow read: if true;

      allow create: if
        hasRequiredFields(request.resource.data, ['name', 'role', 'active', 'pin_hash']) &&
        isNonEmptyString(request.resource.data.name) &&
        isValidRole(request.resource.data.role) &&
        request.resource.data.active is bool &&
        isNonEmptyString(request.resource.data.pin_hash);

      allow update: if
        (!('name' in request.resource.data) ||
          isNonEmptyString(request.resource.data.name)) &&
        (!('role' in request.resource.data) ||
          isValidRole(request.resource.data.role)) &&
        (!('active' in request.resource.data) ||
          request.resource.data.active is bool) &&
        (!('is_locked' in request.resource.data) ||
          request.resource.data.is_locked is bool) &&
        (!('failed_attempts' in request.resource.data) ||
          request.resource.data.failed_attempts is number);

      allow delete: if false;
    }

    // =========================================================================
    // TRANSACTIONS COLLECTION
    // =========================================================================

    match /transactions/{transactionId} {
      allow read: if true;

      allow create: if
        hasRequiredFields(request.resource.data, [
          'transaction_number',
          'employee_id',
          'total',
          'payment_method',
          'payment_status',
          'items'
        ]) &&
        isNonEmptyString(request.resource.data.transaction_number) &&
        isNonEmptyString(request.resource.data.employee_id) &&
        request.resource.data.total is number &&
        request.resource.data.total >= 0 &&
        isValidPaymentMethod(request.resource.data.payment_method) &&
        isValidPaymentStatus(request.resource.data.payment_status) &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0;

      allow update: if
        onlyUpdates([
          'payment_status',
          'synced',
          'void_reason',
          'void_by',
          'void_at',
          'payment_reference',
          'moniepoint_status'
        ]) &&
        (!('payment_status' in request.resource.data) ||
          isValidPaymentStatus(request.resource.data.payment_status));

      allow delete: if false;
    }

    // =========================================================================
    // SETTINGS COLLECTION
    // =========================================================================

    match /settings/{settingId} {
      allow read: if true;

      allow create: if
        settingId == 'global' &&
        hasRequiredFields(request.resource.data, [
          'store_name', 'currency', 'tax_rate', 'tax_enabled'
        ]) &&
        isNonEmptyString(request.resource.data.store_name) &&
        isNonEmptyString(request.resource.data.currency) &&
        request.resource.data.tax_rate is number &&
        request.resource.data.tax_enabled is bool;

      allow update: if
        settingId == 'global' &&
        (!('store_name' in request.resource.data) ||
          isNonEmptyString(request.resource.data.store_name)) &&
        (!('tax_rate' in request.resource.data) ||
          request.resource.data.tax_rate is number);

      allow delete: if false;
    }

    // =========================================================================
    // AUDIT LOGS COLLECTION
    // =========================================================================

    match /audit_logs/{logId} {
      allow read: if true;

      allow create: if
        hasRequiredFields(request.resource.data, ['action', 'employee_id', 'timestamp']) &&
        isNonEmptyString(request.resource.data.action) &&
        isNonEmptyString(request.resource.data.employee_id);

      allow update: if false;
      allow delete: if false;
    }

    // =========================================================================
    // MONIEPOINT WEBHOOK RESULTS
    // =========================================================================

    match /moniepoint_webhook_results/{merchantReference} {
      allow read: if true;
      allow write: if false; 
    }

    // =========================================================================
    // MONIEPOINT PROCESSED WEBHOOKS
    // =========================================================================

    match /moniepoint_processed_webhooks/{webhookId} {
      allow read, write: if false;
    }

    // =========================================================================
    // SYSTEM CACHE
    // =========================================================================

    match /system_cache/{cacheKey} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }

  }
}